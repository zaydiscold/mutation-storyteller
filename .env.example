# Server-only credentials. Never use NEXT_PUBLIC_ for a key.
# If both are set, hosted research uses OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# BYOK works without a hosted key. Keys supplied in the UI are request-scoped.
